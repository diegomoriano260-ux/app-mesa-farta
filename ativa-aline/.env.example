# --- Banco (Supabase: Project Settings > Database > Connection pooling, porta 6543) ---
DATABASE_URL=postgres://usuario:senha@host:6543/postgres

# --- Painel ---
APP_URL=https://seu-app.vercel.app      # sem barra no final
ADMIN_PASSWORD=                          # senha para entrar no painel
SESSION_SECRET=                          # 32+ caracteres aleatórios
TOKEN_ENCRYPTION_KEY=                    # 64 caracteres hex: openssl rand -hex 32
CRON_SECRET=                             # a Vercel manda como "Authorization: Bearer ..."

# --- Meta: app ---
META_APP_SECRET=                         # Configurações do app > Básico
META_WEBHOOK_VERIFY_TOKEN=               # você inventa; igual ao do painel de webhooks

# --- Instagram (API com login do Instagram) ---
IG_APP_ID=                               # ID do app do Instagram (caso de uso Instagram)
IG_APP_SECRET=                           # Chave secreta do app do Instagram

# --- Opcional: só para testes locais ---
# GRAPH_IG_BASE=http://localhost:4010    # finge a API do Instagram
# GRAPH_FB_BASE=http://localhost:4010    # finge a API do WhatsApp
# IG_OAUTH_BASE=http://localhost:4010
